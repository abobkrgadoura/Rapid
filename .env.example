NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional. When set to an absolute origin (https://rapid.example), waybill QR
# codes encode that origin plus /track/{code}. Leave unset to encode the path.
# NEXT_PUBLIC_SITE_URL=https://your-public-site

# Server-only. Never prefix with NEXT_PUBLIC_. Used to compose WhatsApp messages
# (customer phone, delivery OTP) that the acting driver is not allowed to read.
# Leave unset to turn order-event WhatsApp messages off.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# /api/webhooks/whatsapp. The route answers 503 until these are set.
# POST: send WHATSAPP_WEBHOOK_SECRET as `x-webhook-secret` or a Bearer token.
# GET (Meta subscription handshake): WHATSAPP_VERIFY_TOKEN.
WHATSAPP_WEBHOOK_SECRET=a_long_random_string
WHATSAPP_VERIFY_TOKEN=another_long_random_string

# Server-only. Meta WhatsApp Cloud API (src/lib/whatsapp.ts).
# Both are required to send template messages:
#   WHATSAPP_ACCESS_TOKEN        permanent token from the Meta app
#   WHATSAPP_PHONE_NUMBER_ID     Cloud API phone number id
# If either is missing, the app logs a warning and skips the request.
# It does not throw, so local development works without Meta credentials.
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
